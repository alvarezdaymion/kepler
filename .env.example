# Copy to .env (never commit it) or export these in the environment your scheduler uses.
# Use read-only credentials. Kepler sends GETs only, except the single Meta pause behind auto-cut.

# Meta Marketing API: a system-user token with ads_read.
# Add ads_management only when you switch [auto_cut] mode to "live".
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Stripe: a restricted key with read access to Charges (starts with rk_).
STRIPE_API_KEY=

# Optional analysis panel ([analysis] enabled = true, `uv sync --extra llm`).
ANTHROPIC_API_KEY=
